# Nebius Token Factory (OpenAI-compatible). Verify the base URL and model ids
# in your Token Factory console / model catalog before running.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Nemotron tiers. Copy the exact model ids from the Token Factory catalog.
DLEDGER_MODEL_NANO=
DLEDGER_MODEL_SUPER=
DLEDGER_MODEL_ULTRA=

# Optional: Tavily for external fact checks
TAVILY_API_KEY=

# Optional password gate for a hosted synthetic demo. Set both together.
# DLEDGER_DEMO_USER=judge
# DLEDGER_DEMO_PASSWORD=choose_a_separate_demo_password
